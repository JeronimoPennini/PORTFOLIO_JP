im\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n:::\n\n---\n\n# Situación en Neuquén: internaciones en Salud Mental\n\nEl **Primer Censo Nacional de Personas Internadas por Motivos de Salud Mental (2019)**\nreveló que en todo el país había **12.035 personas** internadas, con una permanencia\npromedio de **8,2 años** (rango: 1–90 años).\n\nEn la **Provincia de Neuquén**, para 2019 había **99 personas internadas** en\n**3 instituciones privadas** vinculadas al sistema público mediante convenios:\n\n| Institución | Año del convenio | Localidad |\n|---|---|---|\n| Valle Sereno | 1998 | Neuquén capital |\n| Vida Bella | 2004 | Neuquén capital |\n| CIPEC | 2006–2007 | Centenario |\n\n::: panel-tabset\n\n## Instituciones vs. personas internadas — Argentina 2019\n\n\n::: {.cell}\n\n```{.r .cell-code}\ndf_sector <- tibble(\n  sector = c(\"Privado\", \"Público\"),\n  pct_instituciones = c(75, 25),\n  pct_personas = c(48, 52)\n) |>\n  pivot_longer(\n    cols = c(pct_instituciones, pct_personas),\n    names_to = \"tipo\",\n    values_to = \"pct\"\n  ) |>\n  mutate(\n    tipo_label = if_else(tipo == \"pct_instituciones\",\n      \"% de instituciones\", \"% de personas internadas\"\n    )\n  )\n\nplot_ly(df_sector, height = 400, x = ~tipo_label, y = ~pct, color = ~sector,\n        colors = c(\"#011638\", \"#4a7c59\"), type = \"bar\",\n        text = ~paste0(pct, \" %\"), textposition = \"inside\",\n        insidetextanchor = \"middle\", textfont = list(color = \"white\", size = 18),\n        hovertemplate = \"%{x}<br>%{y} %<extra>%{fullData.name}</extra>\") |>\n  layout(barmode = \"stack\",\n         paper_bgcolor = \"white\", plot_bgcolor = \"white\",\n         margin = list(l = 55, r = 20, t = 25, b = 95),\n         xaxis = list(title = \"\", automargin = TRUE,\n                      tickvals = c(\"% de instituciones\", \"% de personas internadas\"),\n                      ticktext = c(\"Instituciones\", \"Personas<br>internadas\")),\n         yaxis = list(title = \"Porcentaje (%)\", range = c(0, 100)),\n         legend = list(orientation = \"h\", x = 0.5, xanchor = \"center\", y = -0.2)) |>\n  config(displayModeBar = FALSE, responsive = TRUE)\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div id=\"htmlwidget-9e8d241f3e1c20fb5875\" style=\"width:100%;height:386px;\" class=\"plotly html-widget\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-9e8d241f3e1c20fb5875\">{\"x\":{\"visdat\":{\"2c586eec5772\":[\"function () \",\"plotlyVisDat\"]},\"cur_data\":\"2c586eec5772\",\"attrs\":{\"2c586eec5772\":{\"x\":{},\"y\":{},\"text\":{},\"textposition\":\"inside\",\"insidetextanchor\":\"middle\",\"textfont\":{\"color\":\"white\",\"size\":18},\"hovertemplate\":\"%{x}<br>%{y} %<extra>%{fullData.name}<\\/extra>\",\"color\":{},\"colors\":[\"#011638\",\"#4a7c59\"],\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"type\":\"bar\"}},\"layout\":{\"height\":400,\"margin\":{\"b\":95,\"l\":55,\"t\":25,\"r\":20},\"barmode\":\"stack\",\"paper_bgcolor\":\"white\",\"plot_bgcolor\":\"white\",\"xaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"\",\"tickvals\":[\"% de instituciones\",\"% de personas internadas\"],\"ticktext\":[\"Instituciones\",\"Personas<br>internadas\"]},\"yaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"Porcentaje (%)\",\"range\":[0,100]},\"legend\":{\"orientation\":\"h\",\"x\":0.5,\"xanchor\":\"center\",\"y\":-0.20000000000000001},\"hovermode\":\"closest\",\"showlegend\":true},\"source\":\"A\",\"config\":{\"modeBarButtonsToAdd\":[\"hoverclosest\",\"hovercompare\"],\"showSendToCloud\":false,\"displayModeBar\":false,\"responsive\":true},\"data\":[{\"x\":[\"% de instituciones\",\"% de personas internadas\"],\"y\":[75,48],\"text\":[\"75 %\",\"48 %\"],\"textposition\":[\"inside\",\"inside\"],\"insidetextanchor\":\"middle\",\"textfont\":{\"color\":\"white\",\"size\":18},\"hovertemplate\":[\"%{x}<br>%{y} %<extra>%{fullData.name}<\\/extra>\",\"%{x}<br>%{y} %<extra>%{fullData.name}<\\/extra>\"],\"type\":\"bar\",\"name\":\"Privado\",\"marker\":{\"color\":\"rgba(1,22,56,1)\",\"line\":{\"color\":\"rgba(1,22,56,1)\"}},\"error_y\":{\"color\":\"rgba(1,22,56,1)\"},\"error_x\":{\"color\":\"rgba(1,22,56,1)\"},\"xaxis\":\"x\",\"yaxis\":\"y\",\"frame\":null},{\"x\":[\"% de instituciones\",\"% de personas internadas\"],\"y\":[25,52],\"text\":[\"25 %\",\"52 %\"],\"textposition\":[\"inside\",\"inside\"],\"insidetextanchor\":\"middle\",\"textfont\":{\"color\":\"white\",\"size\":18},\"hovertemplate\":[\"%{x}<br>%{y} %<extra>%{fullData.name}<\\/extra>\",\"%{x}<br>%{y} %<extra>%{fullData.name}<\\/extra>\"],\"type\":\"bar\",\"name\":\"Público\",\"marker\":{\"color\":\"rgba(74,124,89,1)\",\"line\":{\"color\":\"rgba(74,124,89,1)\"}},\"error_y\":{\"color\":\"rgba(74,124,89,1)\"},\"error_x\":{\"color\":\"rgba(74,124,89,1)\"},\"xaxis\":\"x\",\"yaxis\":\"y\",\"frame\":null}],\"highlight\":{\"on\":\"plotly_click\",\"persistent\":false,\"dynamic\":false,\"selectize\":false,\"opacityDim\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n## Duración de internaciones\n\n\n::: {.cell}\n\n```{.r .cell-code}\nperm <- tibble(\n  escenario = c(\"Mínimo documentado\", \"Promedio nacional\", \"Máximo documentado\"),\n  anios = c(1, 8.2, 90),\n  cat = c(\"min\", \"prom\", \"max\")\n)\n\np_perm <- ggplot(\n  perm,\n  aes(\n    x = escenario, y = anios, fill = cat,\n    text = paste0(\"<b>\", escenario, \"</b><br>\", anios, \" años de internación\")\n  )\n) +\n  geom_col(width = 0.5, show.legend = FALSE) +\n  geom_text(aes(label = paste0(anios, \" años\")), vjust = -0.5, fontface = \"bold\", size = 4.5, color = \"#011638\") +\n  scale_fill_manual(values = c(\"min\" = \"#d5bdaf\", \"prom\" = \"#277da1\", \"max\" = \"#e76f51\")) +\n  scale_y_continuous(limits = c(0, 105)) +\n  labs(\n    title = \"Duración de internaciones en instituciones monovalentes\",\n    subtitle = \"Argentina · Censo Nacional, 2019\",\n    x = NULL, y = \"Años\"\n  )\n\nggplotly(p_perm, tooltip = \"text\") |> layout(showlegend = FALSE)\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-57c2adab72313a3c0fc2\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-57c2adab72313a3c0fc2\">{\"x\":{\"data\":[{\"orientation\":\"v\",\"width\":0.5,\"base\":0,\"x\":[1],\"y\":[90],\"text\":\"<b>Máximo documentado<\\/b><br>90 años de internación\",\"type\":\"bar\",\"textposition\":\"none\",\"marker\":{\"autocolorscale\":false,\"color\":\"rgba(231,111,81,1)\",\"line\":{\"width\":1.8897637795275593,\"color\":\"transparent\"}},\"name\":\"max\",\"legendgroup\":\"max\",\"showlegend\":true,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null},{\"orientation\":\"v\",\"width\":0.5,\"base\":0,\"x\":[2],\"y\":[1],\"text\":\"<b>Mínimo documentado<\\/b><br>1 años de internación\",\"type\":\"bar\",\"textposition\":\"none\",\"marker\":{\"autocolorscale\":false,\"color\":\"rgba(213,189,175,1)\",\"line\":{\"width\":1.8897637795275593,\"color\":\"transparent\"}},\"name\":\"min\",\"legendgroup\":\"min\",\"showlegend\":true,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null},{\"orientation\":\"v\",\"width\":0.5,\"base\":0,\"x\":[3],\"y\":[8.1999999999999993],\"text\":\"<b>Promedio nacional<\\/b><br>8.2 años de internación\",\"type\":\"bar\",\"textposition\":\"none\",\"marker\":{\"autocolorscale\":false,\"color\":\"rgba(39,125,161,1)\",\"line\":{\"width\":1.8897637795275593,\"color\":\"transparent\"}},\"name\":\"prom\",\"legendgroup\":\"prom\",\"showlegend\":true,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null},{\"x\":[1],\"y\":[90],\"text\":\"90 años\",\"hovertext\":\"<b>Máximo documentado<\\/b><br>90 años de internación\",\"textfont\":{\"size\":17.007874015748033,\"color\":\"rgba(1,22,56,1)\"},\"type\":\"scatter\",\"mode\":\"text\",\"hoveron\":\"points\",\"name\":\"max\",\"legendgroup\":\"max\",\"showlegend\":false,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null},{\"x\":[2],\"y\":[1],\"text\":\"1 años\",\"hovertext\":\"<b>Mínimo documentado<\\/b><br>1 años de internación\",\"textfont\":{\"size\":17.007874015748033,\"color\":\"rgba(1,22,56,1)\"},\"type\":\"scatter\",\"mode\":\"text\",\"hoveron\":\"points\",\"name\":\"min\",\"legendgroup\":\"min\",\"showlegend\":false,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null},{\"x\":[3],\"y\":[8.1999999999999993],\"text\":\"8.2 años\",\"hovertext\":\"<b>Promedio nacional<\\/b><br>8.2 años de internación\",\"textfont\":{\"size\":17.007874015748033,\"color\":\"rgba(1,22,56,1)\"},\"type\":\"scatter\",\"mode\":\"text\",\"hoveron\":\"points\",\"name\":\"prom\",\"legendgroup\":\"prom\",\"showlegend\":false,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null}],\"layout\":{\"margin\":{\"t\":43.23121627231216,\"r\":8.6342880863428828,\"b\":26.766293067662936,\"l\":50.942299709423011},\"paper_bgcolor\":\"rgba(255,255,255,1)\",\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":17.268576172685762},\"title\":{\"text\":\"<b> Duración de internaciones en instituciones monovalentes <\\/b>\",\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":18.596928185969279},\"x\":0,\"xref\":\"paper\"},\"xaxis\":{\"domain\":[0,1],\"automargin\":true,\"type\":\"linear\",\"autorange\":false,\"range\":[0.40000000000000002,3.6000000000000001],\"tickmode\":\"array\",\"ticktext\":[\"Máximo documentado\",\"Mínimo documentado\",\"Promedio nacional\"],\"tickvals\":[1,2,3],\"categoryorder\":\"array\",\"categoryarray\":[\"Máximo documentado\",\"Mínimo documentado\",\"Promedio nacional\"],\"nticks\":null,\"ticks\":\"\",\"tickcolor\":null,\"ticklen\":4.3171440431714405,\"tickwidth\":0,\"showticklabels\":true,\"tickfont\":{\"color\":\"rgba(77,77,77,1)\",\"family\":\"\",\"size\":13.814860938148611},\"tickangle\":-0,\"showline\":false,\"linecolor\":null,\"linewidth\":0,\"showgrid\":true,\"gridcolor\":\"rgba(235,235,235,1)\",\"gridwidth\":0.78493528057662576,\"zeroline\":false,\"anchor\":\"y\",\"title\":{\"text\":\"\",\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":17.268576172685762}},\"hoverformat\":\".2f\"},\"yaxis\":{\"domain\":[0,1],\"automargin\":true,\"type\":\"linear\",\"autorange\":false,\"range\":[-5.25,110.25],\"tickmode\":\"array\",\"ticktext\":[\"0\",\"25\",\"50\",\"75\",\"100\"],\"tickvals\":[0,25,50,75,100],\"categoryorder\":\"array\",\"categoryarray\":[\"0\",\"25\",\"50\",\"75\",\"100\"],\"nticks\":null,\"ticks\":\"\",\"tickcolor\":null,\"ticklen\":4.3171440431714414,\"tickwidth\":0,\"showticklabels\":true,\"tickfont\":{\"color\":\"rgba(77,77,77,1)\",\"family\":\"\",\"size\":13.814860938148611},\"tickangle\":-0,\"showline\":false,\"linecolor\":null,\"linewidth\":0,\"showgrid\":true,\"gridcolor\":\"rgba(235,235,235,1)\",\"gridwidth\":0.78493528057662576,\"zeroline\":false,\"anchor\":\"x\",\"title\":{\"text\":\"Años\",\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":17.268576172685762}},\"hoverformat\":\".2f\"},\"shapes\":[],\"showlegend\":false,\"legend\":{\"bgcolor\":null,\"bordercolor\":null,\"borderwidth\":0,\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":13.814860938148611},\"orientation\":\"h\",\"x\":0.5,\"y\":-0.14999999999999999,\"xanchor\":\"center\",\"yanchor\":\"top\",\"title\":{\"text\":\"\",\"font\":{\"color\":\"rgba(0,0,0,1)\",\"family\":\"\",\"size\":17.268576172685762}}},\"hovermode\":\"closest\",\"barmode\":\"relative\"},\"config\":{\"doubleClick\":\"reset\",\"modeBarButtonsToAdd\":[\"hoverclosest\",\"hovercompare\"],\"showSendToCloud\":false},\"source\":\"A\",\"attrs\":{\"2c581559c66\":{\"x\":{},\"y\":{},\"fill\":{},\"text\":{},\"type\":\"bar\"},\"2c5866833c93\":{\"x\":{},\"y\":{},\"fill\":{},\"text\":{},\"label\":{}}},\"cur_data\":\"2c581559c66\",\"visdat\":{\"2c581559c66\":[\"function (y) \",\"x\"],\"2c5866833c93\":[\"function (y) \",\"x\"]},\"highlight\":{\"on\":\"plotly_click\",\"persistent\":false,\"dynamic\":false,\"selectize\":false,\"opacityDim\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n:::\n\n---\n\n# Distribución territorial de los DIH en Neuquén\n\n**Mapa ilustrativo:** los puntos ubican localidades, no domicilios de dispositivos.\nLos estados y detalles son un escenario demostrativo y no un inventario oficial de 2025.\n\n\n::: {.cell}\n\n```{.r .cell-code}\nlocalidades <- tibble(\n  localidad = c(\"Neuquén capital\", \"Centenario\", \"Zapala\",\n                \"San Martín de los Andes\", \"Chos Malal\", \"Cutral-Có\"),\n  lat = c(-38.9516, -38.8286, -38.8991, -40.1567, -37.3791, -38.9347),\n  lon = c(-68.0591, -68.1287, -70.0538, -71.3567, -70.2671, -69.2317),\n  tipo = c(\"DIH activo\", \"Externación en curso\", \"DIH proyectado\",\n           \"DIH proyectado\", \"Sin DIH\", \"Sin DIH\"),\n  detalle = c(\n    \"1° DIH provincial 'Ana Maria Firman'<br>Inaugurado dic. 2023 · 6 plazas\",\n    \"Inst. CIPEC — externaciones activas desde 2024<br>DIH en construcción\",\n    \"Zona sanitaria IV · DIH en planificación\",\n    \"Zona sanitaria VII · DIH en planificación\",\n    \"Zona sanitaria I · Sin DIH proyectado aún\",\n    \"Zona sanitaria III · Sin DIH proyectado aún\"\n  )\n)\n\ncolores_marcador <- c(\n  \"DIH activo\"           = \"#4a7c59\",\n  \"Externación en curso\" = \"#277da1\",\n  \"DIH proyectado\"       = \"#c45736\",\n  \"Sin DIH\"              = \"#757575\"\n)\n\nlocalidades <- localidades |>\n  mutate(color_marcador = unname(colores_marcador[tipo]))\nstopifnot(!anyNA(localidades$color_marcador),\n          all(localidades$lat >= -90 & localidades$lat <= 90),\n          all(localidades$lon >= -180 & localidades$lon <= 180))\nmapa <- leaflet(localidades, height = 480,\n                options = leafletOptions(scrollWheelZoom = FALSE)) |>\n  addTiles(urlTemplate = \"https://tile.openstreetmap.org/{z}/{x}/{y}.png\",\n           attribution = '&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors') |>\n  fitBounds(lng1 = min(localidades$lon) - 0.2, lat1 = min(localidades$lat) - 0.2,\n            lng2 = max(localidades$lon) + 0.2, lat2 = max(localidades$lat) + 0.2) |>\n  addCircleMarkers(\n    lng = ~lon, lat = ~lat,\n    color = ~color_marcador,\n    fillColor = ~color_marcador,\n    fillOpacity = 0.85,\n    radius = 12,\n    stroke = TRUE, weight = 2,\n    popup = ~paste0(\"<b>\", localidad, \"</b><br><i>\", tipo, \"</i><br><br>\", detalle),\n    label = ~localidad\n  ) |>\n  addLegend(\n    position = \"bottomright\",\n    colors = unname(colores_marcador),\n    labels = names(colores_marcador),\n    title = \"Estado · Neuquén 2025\",\n    opacity = 0.9\n  )\n\nmapa\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div id=\"htmlwidget-4433b98f7130c28e3171\" style=\"width:100%;height:464px;\" class=\"leaflet html-widget\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-4433b98f7130c28e3171\">{\"x\":{\"options\":{\"crs\":{\"crsClass\":\"L.CRS.EPSG3857\",\"code\":null,\"proj4def\":null,\"projectedBounds\":null,\"options\":{}},\"scrollWheelZoom\":false},\"calls\":[{\"method\":\"addTiles\",\"args\":[\"https://tile.openstreetmap.org/{z}/{x}/{y}.png\",null,null,{\"minZoom\":0,\"maxZoom\":18,\"tileSize\":256,\"subdomains\":\"abc\",\"errorTileUrl\":\"\",\"tms\":false,\"noWrap\":false,\"zoomOffset\":0,\"zoomReverse\":false,\"opacity\":1,\"zIndex\":1,\"detectRetina\":false,\"attribution\":\"&copy; <a href=\\\"https://www.openstreetmap.org/copyright\\\">OpenStreetMap<\\/a> contributors\"}]},{\"method\":\"addCircleMarkers\",\"args\":[[-38.9516,-38.8286,-38.8991,-40.1567,-37.3791,-38.9347],[-68.0591,-68.12869999999999,-70.0538,-71.3567,-70.2671,-69.2317],12,null,null,{\"interactive\":true,\"className\":\"\",\"stroke\":true,\"color\":[\"#4a7c59\",\"#277da1\",\"#c45736\",\"#c45736\",\"#757575\",\"#757575\"],\"weight\":2,\"opacity\":0.5,\"fill\":true,\"fillColor\":[\"#4a7c59\",\"#277da1\",\"#c45736\",\"#c45736\",\"#757575\",\"#757575\"],\"fillOpacity\":0.85},null,null,[\"<b>Neuquén capital<\\/b><br><i>DIH activo<\\/i><br><br>1° DIH provincial 'Ana Maria Firman'<br>Inaugurado dic. 2023 · 6 plazas\",\"<b>Centenario<\\/b><br><i>Externación en curso<\\/i><br><br>Inst. CIPEC — externaciones activas desde 2024<br>DIH en construcción\",\"<b>Zapala<\\/b><br><i>DIH proyectado<\\/i><br><br>Zona sanitaria IV · DIH en planificación\",\"<b>San Martín de los Andes<\\/b><br><i>DIH proyectado<\\/i><br><br>Zona sanitaria VII · DIH en planificación\",\"<b>Chos Malal<\\/b><br><i>Sin DIH<\\/i><br><br>Zona sanitaria I · Sin DIH proyectado aún\",\"<b>Cutral-Có<\\/b><br><i>Sin DIH<\\/i><br><br>Zona sanitaria III · Sin DIH proyectado aún\"],null,[\"Neuquén capital\",\"Centenario\",\"Zapala\",\"San Martín de los Andes\",\"Chos Malal\",\"Cutral-Có\"],{\"interactive\":false,\"permanent\":false,\"direction\":\"auto\",\"opacity\":1,\"offset\":[0,0],\"textsize\":\"10px\",\"textOnly\":false,\"className\":\"\",\"sticky\":true},null]},{\"method\":\"addLegend\",\"args\":[{\"colors\":[\"#4a7c59\",\"#277da1\",\"#c45736\",\"#757575\"],\"labels\":[\"DIH activo\",\"Externación en curso\",\"DIH proyectado\",\"Sin DIH\"],\"na_color\":null,\"na_label\":\"NA\",\"opacity\":0.9,\"position\":\"bottomright\",\"type\":\"unknown\",\"title\":\"Estado · Neuquén 2025\",\"extra\":null,\"layerId\":null,\"className\":\"info legend\",\"group\":null}]}],\"fitBounds\":[-40.3567,-71.55670000000001,-37.1791,-67.8591,[]],\"limits\":{\"lat\":[-40.1567,-37.3791],\"lng\":[-71.3567,-68.0591]}},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n---\n\n# Fuerza laboral en Salud Mental por zona sanitaria\n\n\n::: {.cell}\n\n```{.r .cell-code}\nfuerza_laboral <- tibble(\n  zona = paste(\"Zona\", c(\"I\", \"II\", \"III\", \"IV\", \"V\", \"VI\", \"VII\")),\n  localidad_ref  = c(\"Chos Malal\", \"Neuquén capital\", \"Cutral-Có\",\n                     \"Zapala\", \"Junín de los Andes\", \"Norquinco\", \"San M. de los Andes\"),\n  psiquiatras    = c(1,  8, 2, 2, 1, 0, 2),\n  psicologos     = c(3, 28, 6, 5, 3, 1, 5),\n  trabajadores_s = c(2, 15, 3, 3, 2, 1, 3),\n  enfermeria_sm  = c(1,  9, 2, 2, 1, 0, 2),\n  poblacion_mil  = c(42, 380, 95, 85, 40, 15, 45)\n) |>\n  mutate(\n    total_prof    = psiquiatras + psicologos + trabajadores_s + enfermeria_sm,\n    ratio_10k     = round((total_prof / poblacion_mil) * 10, 2)\n  )\n\ntabla_fuerza <- fuerza_laboral |>\n  select(\n    Zona = zona,\n    Localidad = localidad_ref,\n    Psiquiatras = psiquiatras,\n    Psicologos = psicologos,\n    `Trab.Sociales` = trabajadores_s,\n    `Enf.SM` = enfermeria_sm,\n    Total = total_prof,\n    `Ratio.x10k` = ratio_10k\n  )\n\nDT::datatable(\n  tabla_fuerza,\n  colnames = c(\n    \"Zona\", \"Localidad ref.\", \"Psiquiatras\", \"Psicólogos/as\",\n    \"Trab. Sociales\", \"Enf. SM\", \"Total\", \"Ratio x 10.000 hab.\"\n  ),\n  options = list(pageLength = 7, dom = \"t\", scrollX = TRUE),\n  rownames = FALSE,\n  caption = \"Fuerza laboral en SM por Zona Sanitaria · Neuquén 2025 (datos ilustrativos)\"\n) |>\n  DT::formatStyle(\n    \"Ratio.x10k\",\n    color = \"#011638\",\n    background = DT::styleColorBar(c(0, max(fuerza_laboral$ratio_10k)), \"#c5dfce\"),\n    backgroundSize = \"100% 80%\",\n    backgroundRepeat = \"no-repeat\",\n    backgroundPosition = \"center\"\n  ) |>\n  DT::formatStyle(\"Total\", fontWeight = \"bold\", color = \"#011638\")\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"datatables html-widget html-fill-item\" id=\"htmlwidget-b86aeab02dc31713d9cc\" style=\"width:100%;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-b86aeab02dc31713d9cc\">{\"x\":{\"filter\":\"none\",\"vertical\":false,\"caption\":\"<caption>Fuerza laboral en SM por Zona Sanitaria · Neuquén 2025 (datos ilustrativos)<\\/caption>\",\"data\":[[\"Zona I\",\"Zona II\",\"Zona III\",\"Zona IV\",\"Zona V\",\"Zona VI\",\"Zona VII\"],[\"Chos Malal\",\"Neuquén capital\",\"Cutral-Có\",\"Zapala\",\"Junín de los Andes\",\"Norquinco\",\"San M. de los Andes\"],[1,8,2,2,1,0,2],[3,28,6,5,3,1,5],[2,15,3,3,2,1,3],[1,9,2,2,1,0,2],[7,60,13,12,7,2,12],[1.67,1.58,1.37,1.41,1.75,1.33,2.67]],\"container\":\"<table class=\\\"display\\\">\\n  <thead>\\n    <tr>\\n      <th>Zona<\\/th>\\n      <th>Localidad ref.<\\/th>\\n      <th>Psiquiatras<\\/th>\\n      <th>Psicólogos/as<\\/th>\\n      <th>Trab. Sociales<\\/th>\\n      <th>Enf. SM<\\/th>\\n      <th>Total<\\/th>\\n      <th>Ratio x 10.000 hab.<\\/th>\\n    <\\/tr>\\n  <\\/thead>\\n<\\/table>\",\"options\":{\"pageLength\":7,\"dom\":\"t\",\"scrollX\":true,\"columnDefs\":[{\"className\":\"dt-right\",\"targets\":[2,3,4,5,6,7]},{\"name\":\"Zona\",\"targets\":0},{\"name\":\"Localidad\",\"targets\":1},{\"name\":\"Psiquiatras\",\"targets\":2},{\"name\":\"Psicologos\",\"targets\":3},{\"name\":\"Trab.Sociales\",\"targets\":4},{\"name\":\"Enf.SM\",\"targets\":5},{\"name\":\"Total\",\"targets\":6},{\"name\":\"Ratio.x10k\",\"targets\":7}],\"order\":[],\"autoWidth\":false,\"orderClasses\":false,\"lengthMenu\":[7,10,25,50,100],\"rowCallback\":\"function(row, data, displayNum, displayIndex, dataIndex) {\\nvar value=data[7]; $(this.api().cell(row, 7).node()).css({'color':'#011638','background':isNaN(parseFloat(value)) || value <= 0.000000 ? '' : 'linear-gradient(90.000000deg, transparent ' + Math.max(2.670000 - value, 0)/2.670000 * 100 + '%, #c5dfce ' + Math.max(2.670000 - value, 0)/2.670000 * 100 + '%)','background-size':'100% 80%','background-repeat':'no-repeat','background-position':'center'});\\nvar value=data[6]; $(this.api().cell(row, 6).node()).css({'font-weight':'bold','color':'#011638'});\\n}\"}},\"evals\":[\"options.rowCallback\"],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n---\n\n# Conclusiones\n\nEl informe concluye que los DIH son una **tecnología sanitaria efectiva y costo-eficiente**\npara la atención de personas con trastornos mentales graves en proceso de\ndesinstitucionalización, con evidencia de mejora en calidad de vida, autonomía y\nreducción del uso de camas hospitalarias.\n\n::: {.callout-important}\n#### Marco normativo\nLa [Ley Nacional de Salud Mental N° 26.657](https://www.argentina.gob.ar/normativa/nacional/ley-26657-175977/texto)\nestablece que la internación debe ser lo más breve posible. En internaciones involuntarias,\nel artículo 24 exige una nueva evaluación independiente si continúan después de 90 días;\nese plazo no constituye un máximo general de internación. La Ley Provincial N° 3.182 (2018) adhiere\nNeuquén a esta normativa. Los DIH son la alternativa concreta que el marco legal exige.\n:::\n\n---\n\n#### Referencias\n\n- Ministerio de Salud de la Provincia de Neuquén (2025). *ETS — Dispositivos Habitacionales: Evaluación de Tecnología Sanitaria sobre Dispositivos de Inclusión Habitacional*. [Acceso al informe](https://salud.neuquen.gob.ar/wp-content/uploads/2026/03/ETS-DISPOSITIVOS-HABITACIONALES-NEUQUEN-2025.pdf)\n- OMS (2022). *Plan de acción integral sobre salud mental 2013-2030*.\n- Argentina (2010). *Ley Nacional de Salud Mental N° 26.657*.\n- Neuquén (2018). *Ley Provincial N° 3.182 — Adhesión a la LNSM*.\n- SIGEN/MSAL (2019). *Primer Censo Nacional de Personas Internadas por Motivos de Salud Mental*.\n",
